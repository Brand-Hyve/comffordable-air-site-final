---
import { formatDate, isoDate, truncate } from '../lib/utils';

export interface Props {
  post: {
    slug: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      author: string;
      category: string;
      image?: string;
      imageAlt?: string;
    };
  };
  index?: number;
  /**
   * 1-based position on the /blog listing page. When set, the card emits the
   * Hyve CMS auto-listing convention (`data-cms-item="blog-posts"` + one
   * `post-<n>-<field>` id per field) so the CMS regenerates the listing from
   * blog-post pages after ingest. Leave unset for related-posts grids — those
   * must NOT look like the listing collection.
   */
  cmsIndex?: number;
  /**
   * Heading level for the post title. The right level depends on context: on
   * /blog/ the previous heading is the page h1, so cards must be h2 or the
   * document skips a level; inside a post's "Related" block they sit under an
   * h2, so h3 is correct there.
   */
  headingLevel?: 'h2' | 'h3';
}

const { post, index = 0, cmsIndex, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const { title, description, pubDate, category, image, imageAlt } = post.data;
const delay = `${Math.min(index, 6) * 80}ms`;
const cmsId = (field: string) => (cmsIndex ? `post-${cmsIndex}-${field}` : undefined);
---

<article
  class="glass-panel glass-panel-hover blog-card animate-on-scroll"
  style={`transition-delay:${delay}`}
  {...cmsIndex ? { 'data-cms-item': 'blog-posts' } : { 'data-cms': `blog-card-${post.slug}` }}
>
  {
    /* CMS cards always render the <img>: the auto-listing matches fields by
       position, so every card must have identical markup. */
    (image || cmsIndex) && (
      <img
        src={image ?? '/images/hero.webp'}
        alt={imageAlt ?? title}
        loading="lazy"
        width="640"
        height="360"
        data-cms-img={cmsId('img')}
      />
    )
  }

  <div class="blog-card-body">
    <div class="blog-meta">
      <span class="blog-category" data-cms={cmsId('category')}>{category}</span>
      <time datetime={isoDate(pubDate)} data-cms={cmsId('date')}>{formatDate(pubDate)}</time>
    </div>

    <Heading class="blog-card-title"
      ><a href={`/blog/${post.slug}/`} data-cms={cmsId('title')}>{title}</a></Heading
    >
    <p data-cms={cmsId('excerpt')}>{truncate(description, 150)}</p>

    <p style="margin:0">
      <a href={`/blog/${post.slug}/`} data-cms={cmsId('read')}>
        Read More <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </p>
  </div>
</article>
