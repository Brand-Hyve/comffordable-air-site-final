---
import { formatDate, isoDate, truncate } from '../lib/utils';

export interface Props {
  post: {
    slug: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      author: string;
      category: string;
      image?: string;
      imageAlt?: string;
    };
  };
  index?: number;
}

const { post, index = 0 } = Astro.props;
const { title, description, pubDate, category, image, imageAlt } = post.data;
const delay = `${Math.min(index, 6) * 80}ms`;
---

<article
  class="glass-panel glass-panel-hover blog-card animate-on-scroll"
  style={`transition-delay:${delay}`}
  data-cms={`blog-card-${post.slug}`}
>
  {image && <img src={image} alt={imageAlt ?? title} loading="lazy" width="640" height="360" />}

  <div class="blog-card-body">
    <div class="blog-meta">
      <span class="blog-category">{category}</span>
      <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
    </div>

    <h3><a href={`/blog/${post.slug}/`}>{title}</a></h3>
    <p>{truncate(description, 150)}</p>

    <p style="margin:0">
      <a href={`/blog/${post.slug}/`}>Read More <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </p>
  </div>
</article>
