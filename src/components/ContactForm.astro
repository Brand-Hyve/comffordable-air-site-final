---
import business from '../config/business.json';
import { absoluteUrl } from '../lib/utils';

/**
 * Contact form — native form-encoded POST to the shared Brand Hyve relay,
 * which forwards the lead as JSON to this client's GHL inbound webhook and
 * 303-redirects the visitor to /thank-you/. Zero JS required, which is what
 * keeps the form alive on a CMS-published page (Hyve CMS strips scripts).
 *
 * GHL's inbound webhook documents JSON only and never redirects — POSTing to
 * it directly would strand the visitor on a raw JSON response. Never point
 * the form straight at the webhook; the relay exists to translate.
 *
 * When ghlWebhookUrl is empty the form has no action and a small script logs
 * the payload to the console instead (documented empty-data behaviour).
 */

export interface Props {
  services?: { id: string; name: string }[];
  webhookUrl?: string;
  cmsPrefix?: string;
  title?: string;
  intro?: string;
}

const {
  services = business.services,
  webhookUrl = business.ghlWebhookUrl,
  cmsPrefix = 'contact-form',
  title = 'Request Your Free Quote',
  intro = 'Tell us what you need and we will get back to you the same business day with clear, upfront pricing.',
} = Astro.props;

const relayUrl = business.formRelayUrl;
const useRelay = Boolean(webhookUrl && relayUrl);
const redirectUrl = absoluteUrl('/thank-you/');
const sourceUrl = absoluteUrl(
  Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`
);
---

<div class="glass-panel">
  <h2 data-cms={`${cmsPrefix}-title`}>{title}</h2>
  <p data-cms={`${cmsPrefix}-intro`}>{intro}</p>

  <form
    class="contact-form"
    id="contact-form"
    method={useRelay ? 'post' : undefined}
    action={useRelay ? relayUrl : undefined}
  >
    {
      useRelay && (
        <>
          {/* Relay routing — where to forward the lead and where to send the visitor. */}
          <input type="hidden" name="_webhook" value={webhookUrl} />
          <input type="hidden" name="_redirect" value={redirectUrl} />
          <input type="hidden" name="_source" value={sourceUrl} />
        </>
      )
    }

    <div class="form-field">
      <label for="cf-name" data-cms={`${cmsPrefix}-label-name`}
        >Full Name <span aria-hidden="true">*</span></label
      >
      <input type="text" id="cf-name" name="name" autocomplete="name" required />
    </div>

    <div class="form-field">
      <label for="cf-email" data-cms={`${cmsPrefix}-label-email`}
        >Email Address <span aria-hidden="true">*</span></label
      >
      <input type="email" id="cf-email" name="email" autocomplete="email" required />
    </div>

    <div class="form-field">
      <label for="cf-phone" data-cms={`${cmsPrefix}-label-phone`}
        >Phone Number <span aria-hidden="true">*</span></label
      >
      <input type="tel" id="cf-phone" name="phone" autocomplete="tel" required />
    </div>

    <div class="form-field">
      <label for="cf-service" data-cms={`${cmsPrefix}-label-service`}>Interested Service</label>
      <select id="cf-service" name="service">
        <option value="">Select a service</option>
        {services.map((service) => <option value={service.name}>{service.name}</option>)}
        <option value="Something else">Something else</option>
      </select>
    </div>

    <div class="form-field">
      <label for="cf-message" data-cms={`${cmsPrefix}-label-message`}>Message / Details</label>
      <textarea id="cf-message" name="message" rows="5"></textarea>
    </div>

    <!-- Honeypot: bots fill this, humans never see it. Checked by the relay too. -->
    <div class="form-hp" aria-hidden="true">
      <label for="cf-company">Company</label>
      <input type="text" id="cf-company" name="company" tabindex="-1" autocomplete="off" />
    </div>

    <p class="form-status" id="cf-status" role="status" aria-live="polite" hidden></p>

    <button class="btn btn-primary" type="submit" id="cf-submit" data-cms={`${cmsPrefix}-submit`}
      >Send My Request</button
    >
  </form>
</div>

<script>
  import { onReady } from '../lib/onReady';

  onReady(() => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    const submit = document.getElementById('cf-submit') as HTMLButtonElement | null;
    const status = document.getElementById('cf-status');
    const hasAction = form.hasAttribute('action');

    form.addEventListener('submit', (event) => {
      if (hasAction) {
        // Native relay submission — just guard against double-submits.
        if (submit) {
          submit.disabled = true;
          submit.textContent = 'Sending...';
        }
        return;
      }

      // No webhook configured yet — log the payload so the form is still testable.
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const data = new FormData(form);
      if (!data.get('company')) {
        console.info('[ContactForm] No webhook configured. Payload:', {
          name: String(data.get('name') ?? ''),
          email: String(data.get('email') ?? ''),
          phone: String(data.get('phone') ?? ''),
          service: String(data.get('service') ?? ''),
          message: String(data.get('message') ?? ''),
          source: window.location.href,
        });
      }
      form.reset();
      if (status) {
        status.textContent = 'Thanks! We received your request and will be in touch shortly.';
        status.className = 'form-status success';
        status.hidden = false;
      }
    });
  });
</script>
