---
import business from '../config/business.json';

export interface Props {
  services?: { id: string; name: string }[];
  webhookUrl?: string;
  cmsPrefix?: string;
  title?: string;
  intro?: string;
}

const {
  services = business.services,
  webhookUrl = business.ghlWebhookUrl,
  cmsPrefix = 'contact-form',
  title = 'Request Your Free Quote',
  intro = 'Tell us what you need and we will get back to you the same business day with clear, upfront pricing.',
} = Astro.props;
---

<div class="glass-panel" data-cms={`${cmsPrefix}-panel`}>
  <h2 data-cms={`${cmsPrefix}-title`}>{title}</h2>
  <p data-cms={`${cmsPrefix}-intro`}>{intro}</p>

  <form
    class="contact-form"
    id="contact-form"
    data-webhook={webhookUrl}
    novalidate
  >
    <div class="form-field">
      <label for="cf-name">Full Name <span aria-hidden="true">*</span></label>
      <input type="text" id="cf-name" name="name" autocomplete="name" required />
    </div>

    <div class="form-field">
      <label for="cf-email">Email Address <span aria-hidden="true">*</span></label>
      <input type="email" id="cf-email" name="email" autocomplete="email" required />
    </div>

    <div class="form-field">
      <label for="cf-phone">Phone Number <span aria-hidden="true">*</span></label>
      <input type="tel" id="cf-phone" name="phone" autocomplete="tel" required />
    </div>

    <div class="form-field">
      <label for="cf-service">Interested Service</label>
      <select id="cf-service" name="service">
        <option value="">Select a service</option>
        {services.map((service) => <option value={service.name}>{service.name}</option>)}
        <option value="Something else">Something else</option>
      </select>
    </div>

    <div class="form-field">
      <label for="cf-message">Message / Details</label>
      <textarea id="cf-message" name="message" rows="5"></textarea>
    </div>

    <!-- Honeypot: bots fill this, humans never see it -->
    <div class="form-hp" aria-hidden="true">
      <label for="cf-company">Company</label>
      <input type="text" id="cf-company" name="company" tabindex="-1" autocomplete="off" />
    </div>

    <p class="form-status" id="cf-status" role="status" aria-live="polite" hidden></p>

    <button class="btn btn-primary" type="submit" id="cf-submit">Send My Request</button>
  </form>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    const submit = document.getElementById('cf-submit') as HTMLButtonElement | null;
    const status = document.getElementById('cf-status');
    const webhook = form.dataset.webhook ?? '';
    const defaultLabel = submit?.textContent ?? 'Send My Request';

    const setStatus = (message: string, kind: 'success' | 'error') => {
      if (!status) return;
      status.textContent = message;
      status.className = `form-status ${kind}`;
      status.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);

      // Honeypot tripped — pretend success, send nothing.
      if (data.get('company')) {
        form.reset();
        setStatus('Thanks! We will be in touch shortly.', 'success');
        return;
      }

      const payload = {
        name: String(data.get('name') ?? ''),
        email: String(data.get('email') ?? ''),
        phone: String(data.get('phone') ?? ''),
        service: String(data.get('service') ?? ''),
        message: String(data.get('message') ?? ''),
        source: window.location.href,
      };

      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending...';
      }

      try {
        if (!webhook) {
          // No webhook configured yet — log the payload so the form is still testable.
          console.info('[ContactForm] No webhook configured. Payload:', payload);
        } else {
          const response = await fetch(webhook, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!response.ok) throw new Error(`Request failed with ${response.status}`);
        }

        form.reset();
        setStatus('Thanks! We received your request and will be in touch shortly.', 'success');
      } catch (error) {
        console.error('[ContactForm]', error);
        setStatus(
          'Something went wrong sending your request. Please call us and we will take care of it.',
          'error'
        );
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = defaultLabel;
        }
      }
    });
  });
</script>
