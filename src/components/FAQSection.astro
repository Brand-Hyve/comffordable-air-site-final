---
import { faqPageNode } from '../lib/schema';

/**
 * Native <details>/<summary> accordion — answers are reachable with zero JS
 * (and after Hyve CMS strips scripts). The `name` attribute gives the
 * one-open-at-a-time behaviour natively in modern browsers; older browsers
 * simply allow multiple items open, which is fine.
 */

export interface Props {
  items: { question: string; answer: string }[];
  cmsPrefix?: string;
  label?: string;
  title?: string;
}

const { items, cmsPrefix = 'faq', label = 'FAQ', title = 'Frequently Asked Questions' } =
  Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const faqSchema = items.length ? faqPageNode(pageUrl, items) : null;
---

{
  items.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <div class="section-head-center">
          <span class="section-label">{label}</span>
          <h2 class="section-title" data-cms={`${cmsPrefix}-title`}>
            {title}
          </h2>
        </div>

        <div class="faq-list" data-cms-collection={`${cmsPrefix}-list`}>
          {items.map((item, index) => (
            <details class="faq-item" name={cmsPrefix} data-cms-item={`${cmsPrefix}-list`}>
              <summary class="faq-question">
                <span data-cms={`${cmsPrefix}-item-${index + 1}-question`}>{item.question}</span>
                <i class="fa-solid fa-chevron-down faq-chevron" aria-hidden="true" />
              </summary>
              <div class="faq-answer">
                <p data-cms={`${cmsPrefix}-item-${index + 1}-answer`}>{item.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>

      {faqSchema && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...faqSchema })} />
      )}
    </section>
  )
}
