---
import { faqPageNode } from '../lib/schema';

export interface Props {
  items: { question: string; answer: string }[];
  cmsPrefix?: string;
  label?: string;
  title?: string;
}

const { items, cmsPrefix = 'faq', label = 'FAQ', title = 'Frequently Asked Questions' } =
  Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const faqSchema = items.length ? faqPageNode(pageUrl, items) : null;
---

{
  items.length > 0 && (
    <section class="section section-alt" data-cms={`${cmsPrefix}-section`}>
      <div class="container">
        <div class="section-head-center">
          <span class="section-label">{label}</span>
          <h2 class="section-title" data-cms={`${cmsPrefix}-title`}>
            {title}
          </h2>
        </div>

        <div class="faq-list" data-cms={`${cmsPrefix}-list`}>
          {items.map((item, index) => (
            <div class="faq-item" data-cms={`${cmsPrefix}-item-${index + 1}`}>
              <button
                class="faq-question"
                type="button"
                aria-expanded="false"
                aria-controls={`${cmsPrefix}-answer-${index + 1}`}
                id={`${cmsPrefix}-question-${index + 1}`}
              >
                <span>{item.question}</span>
                <i class="fa-solid fa-chevron-down faq-chevron" aria-hidden="true" />
              </button>
              <div
                class="faq-answer"
                id={`${cmsPrefix}-answer-${index + 1}`}
                role="region"
                aria-labelledby={`${cmsPrefix}-question-${index + 1}`}
              >
                <p>{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      {faqSchema && (
        <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...faqSchema })} />
      )}
    </section>
  )
}

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.faq-list').forEach((list) => {
      const items = list.querySelectorAll<HTMLElement>('.faq-item');
      items.forEach((item) => {
        const button = item.querySelector<HTMLButtonElement>('.faq-question');
        if (!button) return;
        button.addEventListener('click', () => {
          const isOpen = item.classList.contains('open');
          // Only one item open at a time
          items.forEach((other) => {
            other.classList.remove('open');
            other.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
          });
          if (!isOpen) {
            item.classList.add('open');
            button.setAttribute('aria-expanded', 'true');
          }
        });
      });
    });
  });
</script>
