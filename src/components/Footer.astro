---
import business from '../config/business.json';
import {
  telHref,
  formatAddress,
  formatHours,
  activeSocials,
  socialIcon,
  reviewUrl,
} from '../lib/utils';

/**
 * Site footer. Reads everything from business.json — takes no props.
 *
 * NAP here must stay byte-identical to the NAP in JSON-LD (Schema.astro)
 * and to the client's Google Business Profile (spec §13).
 */

const year = new Date().getFullYear();
const phoneHref = telHref(business.phone);
const address = formatAddress();
const socials = activeSocials();
const footerServices = business.services.slice(0, 5);
const footerAreas = business.serviceAreas.slice(0, 3);
const hasAreas = business.serviceAreas.length > 0;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand -->
      <div>
        <img
          src="/images/logo.webp"
          alt={`${business.name} logo`}
          width="56"
          height="56"
          data-cms-img="footer-logo-img"
        />
        <p class="footer-brand-name" data-cms="footer-brand-name">{business.name}</p>
        <p data-cms="footer-tagline">{business.tagline}</p>
        {
          business.license?.value && (
            <p class="footer-license" data-cms="footer-license">
              {business.license.name}: {business.license.value}
            </p>
          )
        }
      </div>

      <!-- Quick links -->
      <div>
        <h3 data-cms="footer-links-title">Quick Links</h3>
        <ul class="footer-list">
          {
            footerServices.map((service) => (
              <li>
                <a href={`/${service.id}/`} data-cms={`footer-service-${service.id}`}>
                  {service.shortName ?? service.name}
                </a>
              </li>
            ))
          }
          <li><a href="/about/" data-cms="footer-link-about">About Us</a></li>
          <li><a href="/blog/" data-cms="footer-link-blog">Blog</a></li>
          <li><a href="/contact/" data-cms="footer-link-contact">Contact</a></li>
        </ul>
      </div>

      <!-- Service areas -->
      {
        hasAreas && (
          <div>
            <h3 data-cms="footer-areas-title">Service Areas</h3>
            <ul class="footer-list">
              {footerAreas.map((area) => (
                <li>
                  <a href={`/service-areas/${area.id}/`} data-cms={`footer-area-${area.id}`}>
                    {area.name}, {area.state}
                  </a>
                </li>
              ))}
              <li>
                <a href="/service-areas/" data-cms="footer-all-areas">
                  View All Areas
                </a>
              </li>
            </ul>
            <p style="margin-top:1rem">
              <a href={reviewUrl()} rel="noopener" target="_blank" data-cms="gbp-link">
                <i class="fa-brands fa-google" aria-hidden="true" /> Review Us on Google
              </a>
            </p>
          </div>
        )
      }

      <!-- Contact -->
      <div>
        <h3 data-cms="footer-contact-title">Contact</h3>
        <ul class="footer-contact">
          <li class="footer-contact-item">
            <i class="fa-solid fa-phone" aria-hidden="true"></i>
            <a href={phoneHref} data-cms="footer-phone">{business.phone}</a>
          </li>
          <li class="footer-contact-item">
            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
            <a href={`mailto:${business.email}`} data-cms="footer-email">{business.email}</a>
          </li>
          <li class="footer-contact-item">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            <address style="font-style:normal" data-cms="footer-address">{address}</address>
          </li>
          {
            business.hours.length > 0 && (
              <li class="footer-contact-item">
                <i class="fa-solid fa-clock" aria-hidden="true" />
                <ul class="footer-hours">
                  {business.hours.map((entry, i) => (
                    <li data-cms={`footer-hours-${i + 1}`}>{formatHours(entry)}</li>
                  ))}
                </ul>
              </li>
            )
          }
        </ul>

        {
          socials.length > 0 && (
            <div class="footer-socials">
              {socials.map((social) => (
                <a
                  href={social.url}
                  rel="noopener"
                  target="_blank"
                  aria-label={`${business.name} on ${social.platform}`}
                >
                  <i class={socialIcon(social.platform)} aria-hidden="true" />
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>

    <div class="footer-bottom">
      <p data-cms="footer-copyright">&copy; {year} {business.name}. All rights reserved.</p>
      <p><a href="/privacy/" data-cms="footer-privacy-link">Privacy Policy</a> &middot; <a href="/terms/" data-cms="footer-terms-link">Terms &amp; Conditions</a></p>
    </div>
  </div>
</footer>
