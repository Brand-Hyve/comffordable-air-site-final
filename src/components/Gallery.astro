---
import BlogCard from './BlogCard.astro';

interface GalleryPost {
  slug: string;
  data: {
    title: string;
    description: string;
    pubDate: Date;
    author: string;
    category: string;
    image?: string;
    imageAlt?: string;
  };
}

export interface Props {
  photos: { src: string; alt: string; caption: string; category: string }[];
  videos: { youtubeId: string; title: string; description: string }[];
  posts: GalleryPost[];
  cmsPrefix?: string;
}

const { photos, videos, posts, cmsPrefix = 'gallery' } = Astro.props;
---

{
  photos.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head-center">
          <span class="section-label" data-cms={`${cmsPrefix}-photos-label`}>
            Our Work
          </span>
          <h2 class="section-title" data-cms={`${cmsPrefix}-photos-title`}>
            Recent Projects
          </h2>
        </div>

        <div class="gallery-masonry" data-cms-collection={`${cmsPrefix}-photos`}>
          {photos.map((photo, index) => (
            <figure class="gallery-figure animate-on-scroll" data-cms-item={`${cmsPrefix}-photos`}>
              {/* Plain image link — works with zero JS; JS upgrades it to the lightbox. */}
              <a
                class="gallery-item"
                href={photo.src}
                data-lightbox
                aria-label={`View larger: ${photo.caption}`}
              >
                <img
                  src={photo.src}
                  alt={photo.alt}
                  loading="lazy"
                  width="600"
                  height="450"
                  data-cms-img={`${cmsPrefix}-photo-${index + 1}-img`}
                />
              </a>
              <figcaption class="gallery-caption" data-cms={`${cmsPrefix}-photo-${index + 1}-caption`}>
                {photo.caption}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  videos.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <div class="section-head-center">
          <span class="section-label" data-cms={`${cmsPrefix}-videos-label`}>
            Video
          </span>
          <h2 class="section-title" data-cms={`${cmsPrefix}-videos-title`}>
            Watch and Learn
          </h2>
        </div>

        <div class="grid grid-2" data-cms-collection={`${cmsPrefix}-videos`}>
          {videos.map((video, index) => (
            <article
              class="glass-panel animate-on-scroll"
              style="padding:0;overflow:hidden"
              data-cms-item={`${cmsPrefix}-videos`}
            >
              {/*
                Facade: no iframe and no remote thumbnail until the user clicks,
                so the page costs nothing until someone actually wants the video.
                Without JS the link opens the video on YouTube in a new tab.
              */}
              <a
                class="video-facade"
                href={`https://www.youtube.com/watch?v=${video.youtubeId}`}
                target="_blank"
                rel="noopener"
                data-youtube-id={video.youtubeId}
                aria-label={`Play video: ${video.title}`}
              >
                <span class="video-facade-poster">
                  <span class="video-facade-label">{video.title}</span>
                </span>
              </a>
              <div style="padding:1.5rem">
                <h3 data-cms={`${cmsPrefix}-video-${index + 1}-title`}>{video.title}</h3>
                <p style="margin:0" data-cms={`${cmsPrefix}-video-${index + 1}-desc`}>
                  {video.description}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  posts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head-center">
          <span class="section-label" data-cms={`${cmsPrefix}-posts-label`}>
            From the Blog
          </span>
          <h2 class="section-title" data-cms={`${cmsPrefix}-posts-title`}>
            Guides and Advice
          </h2>
        </div>

        {/* Plain grid on purpose — only /blog/ is the CMS "blog-posts" listing
            collection; gallery cards must not look like it. */}
        <div class="blog-grid">
          {posts.map((post, index) => (
            <BlogCard post={post} index={index} />
          ))}
        </div>
      </div>
    </section>
  )
}

<div class="lightbox" id="gallery-lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
  <button class="lightbox-close" id="lightbox-close" type="button" aria-label="Close">&times;</button>
  <img id="lightbox-image" src="" alt="" />
</div>

<script>
  import { onReady } from '../lib/onReady';

  onReady(() => {
    /* ---------- Lightbox (enhancement over the plain image links) ---------- */
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
    const lightboxClose = document.getElementById('lightbox-close');
    const triggers = document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]');

    if (lightbox && lightboxImage && lightboxClose && triggers.length) {
      let lastFocused: HTMLElement | null = null;

      const open = (trigger: HTMLAnchorElement) => {
        lastFocused = trigger;
        const img = trigger.querySelector('img');
        lightboxImage.src = trigger.href;
        lightboxImage.alt = img?.alt ?? '';
        lightbox.hidden = false;
        lightboxClose.focus();
      };

      const close = () => {
        lightbox.hidden = true;
        lightboxImage.src = '';
        lightboxImage.alt = '';
        lastFocused?.focus();
      };

      triggers.forEach((trigger) =>
        trigger.addEventListener('click', (event) => {
          event.preventDefault();
          open(trigger);
        })
      );
      lightboxClose.addEventListener('click', close);
      lightbox.addEventListener('click', (event) => {
        if (event.target === lightbox) close();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !lightbox.hidden) close();
      });
    }

    /* ---------- YouTube facades (enhancement over the watch-page links) ---------- */
    document.querySelectorAll<HTMLAnchorElement>('a[data-youtube-id]').forEach((facade) => {
      facade.addEventListener(
        'click',
        (event) => {
          const id = facade.dataset.youtubeId;
          if (!id) return;
          event.preventDefault();
          const iframe = document.createElement('iframe');
          iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
          iframe.title = facade.getAttribute('aria-label') ?? 'Video';
          iframe.allow =
            'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
          iframe.allowFullscreen = true;
          iframe.loading = 'lazy';
          facade.replaceWith(iframe);
        },
        { once: true }
      );
    });
  });
</script>
