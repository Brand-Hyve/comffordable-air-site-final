---
export interface Props {
  title: string;
  subtitle: string;
  backgroundImage: string;
  overlayStyle?: string;
  ctaPrimary?: { text: string; href: string; icon?: string };
  ctaSecondary?: { text: string; href: string; icon?: string };
  cmsPrefix: string;
  size?: 'full' | 'half';
  center?: boolean;
  /** Intrinsic dimensions of the background image. Defaults match the
      documented 1920×1080 hero assets; pass real values for anything else.
      Without them the LCP image has no aspect ratio to reserve and shifts
      layout on the most visible element of every page. */
  imageWidth?: number;
  imageHeight?: number;
}

const {
  title,
  subtitle,
  backgroundImage,
  overlayStyle,
  ctaPrimary,
  ctaSecondary,
  cmsPrefix,
  size = 'full',
  center = false,
  imageWidth = 1920,
  imageHeight = 1080,
} = Astro.props;
---

<section class:list={['hero', size === 'full' ? 'hero-full' : 'hero-half']}>
  <img
    class="hero-bg"
    src={backgroundImage}
    alt=""
    aria-hidden="true"
    fetchpriority="high"
    width={imageWidth}
    height={imageHeight}
    data-cms-img={`${cmsPrefix}-bg`}
  />
  <div class="hero-overlay" style={overlayStyle}></div>

  <div class="container">
    <div class:list={['hero-inner', center && 'hero-center']}>
      <!-- title may contain a <span> for the accent-colored word -->
      <h1 data-cms={`${cmsPrefix}-title`} set:html={title} />
      <p data-cms={`${cmsPrefix}-subtitle`}>{subtitle}</p>

      {
        (ctaPrimary || ctaSecondary) && (
          <div class="hero-actions">
            {ctaPrimary && (
              <a class="btn btn-primary" href={ctaPrimary.href} data-cms={`${cmsPrefix}-cta-primary`}>
                {ctaPrimary.icon && <i class={ctaPrimary.icon} aria-hidden="true" />}
                {ctaPrimary.text}
              </a>
            )}
            {ctaSecondary && (
              <a
                class="btn btn-outline"
                href={ctaSecondary.href}
                data-cms={`${cmsPrefix}-cta-secondary`}
              >
                {ctaSecondary.icon && <i class={ctaSecondary.icon} aria-hidden="true" />}
                {ctaSecondary.text}
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
