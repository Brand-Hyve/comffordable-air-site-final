---
export interface Props {
  area: {
    id: string;
    name: string;
    state: string;
    neighborhoods?: string[];
    /** Per-area card copy from business.json; falls back to generic coverage text. */
    blurb?: string;
  };
  /** data-cms-collection id of the surrounding grid, when this card is a collection item. */
  collectionId?: string;
}

const { area, collectionId } = Astro.props;
const neighborhoods = area.neighborhoods?.slice(0, 4) ?? [];
---

<article
  class="glass-panel glass-panel-hover location-card animate-on-scroll"
  data-cms-item={collectionId}
>
  <h3 data-cms={`location-card-${area.id}-title`}>{area.name}, {area.state}</h3>

  {
    neighborhoods.length > 0 && (
      <ul class="chip-list">
        {neighborhoods.map((neighborhood) => (
          <li class="chip">
            <i class="fa-solid fa-location-dot" aria-hidden="true" />
            {neighborhood}
          </li>
        ))}
      </ul>
    )
  }

  <p style="flex:1" data-cms={`location-card-${area.id}-body`}>
    {area.blurb ??
      `Full service coverage across ${area.name} and the surrounding ${area.state} communities.`}
  </p>

  <a
    class="btn btn-outline btn-sm"
    href={`/service-areas/${area.id}/`}
    data-cms={`location-card-${area.id}-cta`}
  >
    View {area.name} Services
  </a>
</article>
