---
import business from '../config/business.json';
import Hero from './Hero.astro';
import { telHref, hasClaim, quoteCta } from '../lib/utils';

export interface Props {
  area: {
    id: string;
    name: string;
    state: string;
    hero?: string;
  };
  phone: string;
}

const { area, phone } = Astro.props;

const title = `${business.industry} Services in <span>${area.name}, ${area.state}</span>`;

// Claim phrases render ONLY when business.json > claims asserts them. The old
// hardcoded subtitle promised same-day appointments, upfront pricing, and a
// written warranty on every client, whether or not any of it was true.
const opener = hasClaim('licensed')
  ? `Local, licensed, and on call for ${area.name} homeowners.`
  : `Local and on call for ${area.name} homeowners.`;
const claimBits = [
  hasClaim('sameDay') && 'Same-day appointments',
  hasClaim('flatPricing') && 'upfront pricing',
  hasClaim('writtenWarranty') && 'work backed by a written warranty',
].filter(Boolean);
const subtitle = claimBits.length
  ? `${opener} ${claimBits.join(', ')}${claimBits.length > 1 ? ',' : ''} and a team that knows the area.`
  : `${opener} Call us and tell us what you need — we know the area.`;
---

<Hero
  title={title}
  subtitle={subtitle}
  backgroundImage={area.hero ?? '/images/hero.webp'}
  cmsPrefix={`location-hero-${area.id}`}
  size="half"
  ctaPrimary={{ text: `Call ${phone}`, href: telHref(phone), icon: 'fa-solid fa-phone' }}
  ctaSecondary={{ text: quoteCta('Request'), href: '/contact/' }}
/>
