---
import business from '../config/business.json';
import { telHref, quoteCta } from '../lib/utils';

/**
 * Sticky site header. Reads everything from business.json — takes no props.
 * Nav links: Home + first 4 services + About + Blog + Contact CTA.
 *
 * The mobile menu is a CSS-only checkbox disclosure (see global.css §7), so it
 * keeps working after Hyve CMS strips scripts. JS only adds polish: closing
 * the menu when a link is tapped and the shrink-on-scroll header.
 */

const navServices = business.services.slice(0, 4);
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => (href.replace(/\/+$/, '') || '/') === currentPath;
const phoneHref = telHref(business.phone);
---

<header class="site-header" id="main-header">
  <div class="container">
    <a class="header-logo" href="/">
      <img
        src="/images/logo.webp"
        alt={`${business.name} logo`}
        width="45"
        height="45"
        data-cms-img="header-logo-img"
      />
      <span class="header-logo-text" data-cms="header-logo-text">{business.shortName}</span>
    </a>

    <input
      class="nav-checkbox"
      id="nav-open"
      type="checkbox"
      aria-label="Toggle navigation menu"
    />
    <label class="nav-toggle" for="nav-open" aria-hidden="true">
      <i class="fa-solid fa-bars nav-icon-open"></i>
      <i class="fa-solid fa-xmark nav-icon-close"></i>
    </label>

    <nav class="main-nav" id="main-nav" aria-label="Main">
      <ul>
        <li>
          <a href="/" data-cms="nav-home" aria-current={isCurrent('/') ? 'page' : undefined}>Home</a>
        </li>
        {
          navServices.map((service) => (
            <li>
              <a
                href={`/${service.id}/`}
                data-cms={`nav-${service.id}`}
                aria-current={isCurrent(`/${service.id}/`) ? 'page' : undefined}
              >
                {service.shortName ?? service.name}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/about/" data-cms="nav-about" aria-current={isCurrent('/about/') ? 'page' : undefined}
            >About</a
          >
        </li>
        <li>
          <a href="/blog/" data-cms="nav-blog" aria-current={isCurrent('/blog/') ? 'page' : undefined}
            >Blog</a
          >
        </li>
        <li>
          <a class="btn btn-primary btn-sm" href="/contact/" data-cms="nav-cta">
            <i class="fa-solid fa-phone" aria-hidden="true"></i> {quoteCta('Get')}
          </a>
        </li>
        <li class="sr-only">
          <a href={phoneHref} data-cms="nav-phone">Call {business.phone}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import { onReady } from '../lib/onReady';

  onReady(() => {
    const header = document.getElementById('main-header');
    const checkbox = document.getElementById('nav-open') as HTMLInputElement | null;
    const nav = document.getElementById('main-nav');

    if (header) {
      const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 20);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    // Enhancement only: collapse the CSS-only menu after a link is tapped.
    if (checkbox && nav) {
      nav.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          checkbox.checked = false;
        });
      });
    }
  });
</script>
