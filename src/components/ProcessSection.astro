---
export interface Props {
  steps: { number: number; title: string; description: string }[];
  label?: string;
  title?: string;
  cmsPrefix?: string;
}

const {
  steps,
  label = 'How It Works',
  title = 'Straightforward From First Call to Final Check',
  cmsPrefix = 'process',
} = Astro.props;
---

<section class="section section-alt">
  <div class="container">
    <div class="section-head-center">
      <span class="section-label" data-cms={`${cmsPrefix}-label`}>{label}</span>
      <h2 class="section-title" data-cms={`${cmsPrefix}-title`}>{title}</h2>
    </div>

    <div class="grid grid-4" data-cms-collection={`${cmsPrefix}-grid`}>
      {
        steps.map((step) => (
          <div class="process-step animate-on-scroll" data-cms-item={`${cmsPrefix}-grid`}>
            <span class="process-number">{step.number}</span>
            <h3 data-cms={`${cmsPrefix}-step-${step.number}-title`}>{step.title}</h3>
            <p data-cms={`${cmsPrefix}-step-${step.number}-desc`}>{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
