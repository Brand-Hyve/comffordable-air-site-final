---
export interface Props {
  scriptSrc?: string;
  iframeSrc?: string;
}

const { scriptSrc, iframeSrc } = Astro.props;

// Renders nothing when neither source is configured.
const hasWidget = Boolean(scriptSrc || iframeSrc);
---

{
  hasWidget && (
    <div class="reviews-widget" data-cms="reviews-widget">
      {iframeSrc && (
        <iframe src={iframeSrc} loading="lazy" title="Customer reviews" />
      )}
      {scriptSrc && <script is:inline async src={scriptSrc} />}
    </div>
  )
}
