---
import '../styles/global.css';
import business from '../config/business.json';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';
import { telHref } from '../lib/utils';
import type {
  PageType,
  Breadcrumb,
  ServiceSchemaInput,
  BlogPostSchemaInput,
  LocationSchemaInput,
} from '../lib/schema';

export interface Props {
  title: string;
  description: string;
  image?: string;
  breadcrumbs?: Breadcrumb[];
  pageType?: PageType;
  noindex?: boolean;
  hideCtaBar?: boolean;
  hideExitPopup?: boolean;
  service?: ServiceSchemaInput;
  blogPost?: BlogPostSchemaInput;
  location?: LocationSchemaInput;
}

const {
  title,
  description,
  image = '/images/logo.webp',
  breadcrumbs = [],
  pageType = 'default',
  noindex = false,
  hideCtaBar = false,
  hideExitPopup = false,
  service,
  blogPost,
  location,
} = Astro.props;

// Trailing-slash convention: enforced sitewide so the canonical always matches
// the URL that actually returns 200 (spec §12).
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const hasGtm = Boolean(business.gtmId);
const hasGa4 = Boolean(business.ga4Id);
const showCookieBanner = business.cookieConsentEnabled && !noindex;
const showExitPopup = !hideExitPopup;
const showCtaBar = !hideCtaBar;
const phoneHref = telHref(business.phone);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title data-cms="page-title">{title}</title>
    <meta name="description" content={description} data-cms="meta-description" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      business.searchConsoleVerification && (
        <meta name="google-site-verification" content={business.searchConsoleVerification} />
      )
    }

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={pageType === 'blog' ? 'article' : 'website'} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Icons + manifest -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0d1b2a" />

    <!--
      Fonts + icons are self-hosted (imported in global.css) — no external
      origins on the critical path and nothing that depends on JS to load.

      Progressive-enhancement gate: `.js` on <html> is what lets the stylesheet
      apply JS-dependent states (scroll animations, CTA-bar slide-in). Hyve CMS
      strips every <script> from a published page, so those pages simply render
      everything visible.
    -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <!-- Structured data: a single @graph per page -->
    <Schema
      pageType={pageType}
      pageUrl={canonicalURL}
      title={title}
      description={description}
      breadcrumbs={breadcrumbs}
      service={service}
      blogPost={blogPost}
      location={location}
      image={ogImage}
    />

    {
      (hasGtm || hasGa4) && (
        <script is:inline>
          // Consent Mode v2 — must run BEFORE any Google tag loads. Defaults to
          // denied, so gtag.js/gtm.js load but set no analytics or ads cookies
          // until the visitor accepts; the banner flips this with an 'update'.
          // Hyve CMS strips scripts on publish, which removes the tags along
          // with this gate, so a published page never tracks either way.
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          var storedConsent = null;
          try {
            storedConsent = localStorage.getItem('cookieConsent');
          } catch (e) {
            // storage blocked (private mode) — treat as no consent
          }
          var consentValue = storedConsent === 'true' ? 'granted' : 'denied';
          gtag('consent', 'default', {
            ad_storage: consentValue,
            ad_user_data: consentValue,
            ad_personalization: consentValue,
            analytics_storage: consentValue,
            functionality_storage: 'granted',
            security_storage: 'granted',
          });
        </script>
      )
    }

    {
      hasGtm && (
        <script is:inline define:vars={{ gtmId: business.gtmId }}>
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', gtmId);
        </script>
      )
    }

    {
      hasGa4 && (
        <Fragment>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${business.ga4Id}`}
          />
          <script is:inline define:vars={{ ga4Id: business.ga4Id }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', ga4Id);
          </script>
        </Fragment>
      )
    }
  </head>

  <body>
    {
      hasGtm && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${business.gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }

    <a class="skip-link" href="#main-content" data-cms="skip-link">Skip to main content</a>

    <Navbar />

    {
      breadcrumbs.length > 0 && (
        <nav class="breadcrumbs container" aria-label="Breadcrumb">
          <ol itemscope itemtype="https://schema.org/BreadcrumbList">
            {breadcrumbs.map((crumb, i) => (
              <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <a href={crumb.href} itemprop="item">
                  <span itemprop="name">{crumb.label}</span>
                </a>
                <meta itemprop="position" content={String(i + 1)} />
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    {
      showCtaBar && (
        <div class="mobile-cta-bar" id="mobile-cta-bar">
          <a class="btn btn-outline btn-sm" href={phoneHref} data-cms="mobile-cta-call">
            <i class="fa-solid fa-phone" aria-hidden="true" /> Call Now
          </a>
          <a class="btn btn-primary btn-sm" href="/contact/" data-cms="mobile-cta-quote">
            <i class="fa-solid fa-calendar-check" aria-hidden="true" /> Free Quote
          </a>
        </div>
      )
    }

    {
      showExitPopup && (
        <div class="exit-popup" id="exit-popup" role="dialog" aria-modal="true" aria-labelledby="exit-popup-title" hidden>
          <div class="exit-popup-inner">
            <button class="exit-popup-close" id="exit-popup-close" type="button" aria-label="Close">
              &times;
            </button>
            <h2 id="exit-popup-title" data-cms="exit-popup-title">
              Wait — Don't Leave Without Your Free Quote!
            </h2>
            <p data-cms="exit-popup-text">
              Get a no-obligation estimate for your home's HVAC repair or maintenance. Takes 30
              seconds.
            </p>
            <a class="btn btn-primary" href="/contact/" data-cms="exit-popup-cta">
              Get My Free Quote
            </a>
            <p style="margin-top:1rem;font-size:0.9rem">
              Or call us directly: <a href={phoneHref} data-cms="exit-popup-phone">{business.phone}</a>
            </p>
          </div>
        </div>
      )
    }

    {
      showCookieBanner && (
        <div class="cookie-banner" id="cookie-banner" hidden>
          <p data-cms="cookie-text">
            We use cookies to improve your experience and analyze site traffic. See our{' '}
            <a href="/privacy/">Privacy Policy</a>.
          </p>
          <button class="btn btn-outline btn-sm" id="cookie-decline" type="button" data-cms="cookie-decline">
            Decline
          </button>
          <button class="btn btn-primary btn-sm" id="cookie-accept" type="button" data-cms="cookie-accept">
            Accept
          </button>
        </div>
      )
    }

    <script>
      import { onReady } from '../lib/onReady';

      // onReady runs at DOM-ready and again after any View Transitions swap.
      onReady(() => {
        // 1. Scroll-triggered fade-in
        const animated = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
        if (animated.length) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
          );
          animated.forEach((el) => observer.observe(el));
        }

        // 2. Floating mobile CTA bar — hidden above 300px scroll
        const ctaBar = document.getElementById('mobile-cta-bar');
        if (ctaBar) {
          const toggleCta = () => {
            ctaBar.classList.toggle('visible', window.scrollY > 300);
          };
          toggleCta();
          window.addEventListener('scroll', toggleCta, { passive: true });
        }

        // 3. Cookie consent banner
        // The head script has already set Consent Mode to denied (or to the
        // visitor's stored choice). This only records a new choice and pushes
        // the matching consent update — the Google tags read that, so nothing
        // is stored until Accept is clicked.
        const banner = document.getElementById('cookie-banner');
        const accept = document.getElementById('cookie-accept');
        const decline = document.getElementById('cookie-decline');
        if (banner && accept) {
          const stored = localStorage.getItem('cookieConsent');
          if (stored !== 'true' && stored !== 'false') {
            banner.hidden = false;
          }
          const record = (allowed: boolean) => {
            localStorage.setItem('cookieConsent', String(allowed));
            const value = allowed ? 'granted' : 'denied';
            const gtag = (window as any).gtag;
            if (typeof gtag === 'function') {
              gtag('consent', 'update', {
                ad_storage: value,
                ad_user_data: value,
                ad_personalization: value,
                analytics_storage: value,
              });
            }
            banner.hidden = true;
          };
          accept.addEventListener('click', () => record(true));
          decline?.addEventListener('click', () => record(false));
        }

        // 4. Exit-intent popup — desktop only, once per session, never on /contact
        const popup = document.getElementById('exit-popup');
        const popupClose = document.getElementById('exit-popup-close');
        const onContactPage = window.location.pathname.replace(/\/$/, '') === '/contact';
        if (popup && popupClose && !onContactPage && window.innerWidth >= 1024) {
          const showPopup = (event: MouseEvent) => {
            if (event.clientY > 0) return;
            if (sessionStorage.getItem('exitPopupShown') === 'true') return;
            sessionStorage.setItem('exitPopupShown', 'true');
            popup.hidden = false;
          };
          const hidePopup = () => {
            popup.hidden = true;
          };
          document.addEventListener('mouseout', showPopup);
          popupClose.addEventListener('click', hidePopup);
          popup.addEventListener('click', (event) => {
            if (event.target === popup) hidePopup();
          });
          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') hidePopup();
          });
        }
      });
    </script>
  </body>
</html>
