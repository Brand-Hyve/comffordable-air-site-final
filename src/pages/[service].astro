---
import type { GetStaticPaths } from 'astro';
import business from '../config/business.json';
import testimonials from '../config/testimonials.json';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import LocationCard from '../components/LocationCard.astro';
import { telHref, cityState, pageTitle, metaDescription } from '../lib/utils';

export const getStaticPaths = (() => {
  return business.services.map((service) => ({
    params: { service: service.id },
    props: { service },
  }));
}) satisfies GetStaticPaths;

const { service } = Astro.props;
const location = cityState();
const content = service.content;

const title = pageTitle(service.metaTitle ?? service.name);
const description = metaDescription(service.metaDescription ?? service.description);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: service.shortName ?? service.name, href: `/${service.id}/` },
];

// The same FAQ list ran on every service page of the original site.
const faqs = business.serviceFaqs;

const hasIntro = Boolean(content.intro.title || content.intro.paragraphs.length);
const hasOutro = Boolean(content.outro.text || content.outro.ctaText);
const relatedServices = business.services.filter((s) => s.id !== service.id).slice(0, 3);
const featuredAreas = business.serviceAreas.slice(0, 3);
---

<Layout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  pageType="service"
  image={content.heroImage}
  service={{ name: service.name, description: service.description }}
>
  <Hero
    title={content.heroTitle}
    subtitle={content.heroSubtitle}
    backgroundImage={content.heroImage}
    cmsPrefix={`service-hero-${service.id}`}
    size="half"
    ctaPrimary={{
      text: `Call ${business.phone}`,
      href: telHref(business.phone),
      icon: 'fa-solid fa-phone',
    }}
    ctaSecondary={{ text: 'Get a Free Quote', href: '/contact/' }}
  />

  {
    hasIntro && (
      <section class="section">
        <div class="container">
          <div class="section-head-center">
            {content.intro.badge && (
              <span class="section-label" data-cms={`service-${service.id}-intro-badge`}>
                {content.intro.badge}
              </span>
            )}
            {content.intro.title && (
              <h2 class="section-title" data-cms={`service-${service.id}-intro-title`}>
                {content.intro.title}
              </h2>
            )}
            {content.intro.paragraphs.map((paragraph, i) => (
              <p class="section-intro" data-cms={`service-${service.id}-intro-p-${i + 1}`}>
                {paragraph}
              </p>
            ))}
            {content.intro.note && (
              <p class="section-intro" data-cms={`service-${service.id}-intro-note`}>
                <strong>{content.intro.note}</strong>
              </p>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    content.cardGroups.map((group, groupIndex) => (
      <section class:list={['section', groupIndex % 2 === 1 && 'section-alt']}>
        <div class="container">
          {(group.label || group.title) && (
            <div class="section-head-center">
              {group.label && (
                <span
                  class="section-label"
                  data-cms={`service-${service.id}-group-${groupIndex + 1}-label`}
                >
                  {group.label}
                </span>
              )}
              {group.title && (
                <h2
                  class="section-title"
                  data-cms={`service-${service.id}-group-${groupIndex + 1}-title`}
                >
                  {group.title}
                </h2>
              )}
            </div>
          )}

          <div
            class:list={['grid', group.cards.length === 4 ? 'grid-4' : 'grid-3']}
            data-cms-collection={`service-${service.id}-group-${groupIndex + 1}-grid`}
          >
            {group.cards.map((card, cardIndex) => {
              const cardPrefix = `service-${service.id}-g${groupIndex + 1}-card-${cardIndex + 1}`;
              return (
                <article
                  class="glass-panel glass-panel-hover service-card animate-on-scroll"
                  data-cms-item={`service-${service.id}-group-${groupIndex + 1}-grid`}
                >
                  {card.badge && (
                    <span class="section-label" data-cms={`${cardPrefix}-badge`}>
                      {card.badge}
                    </span>
                  )}
                  <h3 data-cms={`${cardPrefix}-title`}>{card.title}</h3>
                  {card.paragraphs.map((paragraph, i) => (
                    <p data-cms={`${cardPrefix}-p-${i + 1}`}>{paragraph}</p>
                  ))}
                  {card.features.length > 0 && (
                    <ul class="service-features" data-cms={`${cardPrefix}-features`}>
                      {card.features.map((feature) => (
                        <li>{feature}</li>
                      ))}
                    </ul>
                  )}
                  {card.ctaText && (
                    <a
                      class="btn btn-outline btn-sm"
                      href={card.ctaHref || '/contact/'}
                      data-cms={`${cardPrefix}-cta`}
                    >
                      {card.ctaText}
                    </a>
                  )}
                </article>
              );
            })}
          </div>

          {hasOutro && groupIndex === content.cardGroups.length - 1 && (
            <div class="section-head-center" style="margin-top:2.5rem">
              {content.outro.text && (
                <p class="section-intro" data-cms={`service-${service.id}-outro-text`}>
                  {content.outro.text}
                </p>
              )}
              {content.outro.ctaText && (
                <p style="margin-top:1rem">
                  <a
                    class="btn btn-primary"
                    href={content.outro.ctaHref || '/contact/'}
                    data-cms={`service-${service.id}-outro-cta`}
                  >
                    {content.outro.ctaText}
                  </a>
                </p>
              )}
            </div>
          )}
        </div>
      </section>
    ))
  }

  <section class="section">
    <div class="container">
      <div class="section-head-center">
        <span class="section-label" data-cms={`service-${service.id}-article-label`}>
          {content.article.label}
        </span>
        <h2 class="section-title" data-cms={`service-${service.id}-article-title`}>
          {content.article.title}
        </h2>
      </div>
      <div style="max-width:820px;margin:0 auto">
        {
          content.article.paragraphs.map((paragraph, i) => (
            <p data-cms={`service-${service.id}-article-p-${i + 1}`}>{paragraph}</p>
          ))
        }
      </div>
    </div>
  </section>

  {
    featuredAreas.length > 0 && (
      <section class="section section-alt">
        <div class="container">
          <div class="section-head-center">
            <span class="section-label">Coverage</span>
            <h2 class="section-title">
              {service.shortName ?? service.name} Across {business.location.state}
            </h2>
          </div>
          <div class="grid grid-3" data-cms-collection="coverage-grid">
            {featuredAreas.map((area) => (
              <LocationCard area={area} collectionId="coverage-grid" />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Testimonials
    testimonials={testimonials.slice(0, 3)}
    cmsPrefix={`service-${service.id}-testimonials`}
  />

  <FAQSection items={faqs} title="FAQs" cmsPrefix={`service-${service.id}-faq`} />

  {
    relatedServices.length > 0 && (
      <section class="section section-alt">
        <div class="container">
          <div class="section-head-center">
            <span class="section-label">More Services</span>
            <h2 class="section-title">Other Ways We Can Help</h2>
          </div>
          <div class="grid grid-3" data-cms-collection="related-services-grid">
            {relatedServices.map((related) => (
              <article
                class="glass-panel glass-panel-hover service-card animate-on-scroll"
                data-cms-item="related-services-grid"
              >
                <span class="service-icon">
                  <i class={related.icon} aria-hidden="true" />
                </span>
                <h3 data-cms={`related-${related.id}-title`}>{related.name}</h3>
                <p data-cms={`related-${related.id}-desc`}>{related.description}</p>
                <a
                  class="btn btn-outline btn-sm"
                  href={`/${related.id}/`}
                  data-cms={`related-${related.id}-cta`}
                >
                  View Details
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CTASection
    title={`Need ${service.shortName ?? service.name} today?`}
    subtitle={`Same-day appointments available across ${location}. Get a written quote before any work begins.`}
    ctaText="Get My Free Quote"
    ctaHref="/contact/"
    cmsPrefix={`service-${service.id}-cta`}
  />
</Layout>
