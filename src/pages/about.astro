---
import business from '../config/business.json';
import testimonials from '../config/testimonials.json';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Testimonials from '../components/Testimonials.astro';
import CTASection from '../components/CTASection.astro';
import { pageTitle, metaDescription } from '../lib/utils';

const title = pageTitle('About Us');
const description = metaDescription(
  'Learn more about Comffordable Air Solutions and our dedication to providing premium HVAC repair and maintenance in the Tampa Bay Area.'
);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
];

const storyParagraphs = [
  'I take immense pride in delivering honest, high-quality work that you can count on. My family, especially my daughter and my mom, is my greatest motivation and the reason I strive to grow every single day, both personally and professionally. I truly believe in treating people with fairness and respect, because doing right by others is the only way to build lasting trust and long-term relationships.',
  'My approach to business is simple: be straightforward, communicate clearly, and always stand behind what I do. I don’t believe in cutting corners or overcomplicating things. It’s about doing the job right the first time so you can feel completely confident in your home\'s comfort.',
  'When I’m not working, you’ll usually find me staying active outdoors. Whether I’m out on my bicycle or embarking on a new adventure, I love to stay driven and challenge myself. At the end of the day, I’m committed to providing reliable service and earning your trust with every visit.',
  'Comffordable Air Solutions is more than just a quick fix. We optimize your system\'s performance, protecting your home investment for years to come throughout St. Petersburg, Tampa, and Clearwater.',
];
---

<Layout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  pageType="about"
  image="/images/about.jpg"
>
  <Hero
    title={`Our <span>Story.</span>`}
    subtitle="Unwavering dedication to your home's comfort."
    backgroundImage="/images/about.jpg"
    cmsPrefix="about-hero"
    size="half"
  />

  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        <div>
          <span class="section-label" data-cms="about-label">Our Story</span>
          <h2 class="section-title" data-cms="about-title">Your Trusted HVAC Partner</h2>
          {
            storyParagraphs.map((paragraph, i) => (
              <p data-cms={`about-body-${i + 1}`}>{paragraph}</p>
            ))
          }
          {
            business.license?.value && (
              <p data-cms="about-license">
                <strong>
                  {business.license.name}: {business.license.value}
                </strong>
              </p>
            )
          }
        </div>

        <div class="animate-on-scroll">
          <img
            src="/images/owner-portrait.jpg"
            alt={`John, ${business.name} owner and lead HVAC technician`}
            width="800"
            height="1000"
            loading="lazy"
            style="border-radius:16px;object-fit:cover;width:100%"
            data-cms-img="about-portrait-img"
          />
        </div>
      </div>
    </div>
  </section>

  <Testimonials testimonials={testimonials.slice(0, 3)} title="What Our Neighbors Say" />

  <CTASection
    title="Experience Comffordable Air"
    ctaText="Contact Us Today"
    ctaHref="/contact/"
    cmsPrefix="about-cta"
  />
</Layout>
