---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
---

<Layout title="HVAC Blog | Comffordable Air Solutions" description="Expert HVAC tips, maintenance advice, and industry insights from the Tampa Bay Area's trusted AC professionals.">
    <main>
        <!-- Hero -->
        <section class="hero" style="min-height: 40vh; padding-top: 80px;">
            <img src="/images/pic_5.jpg" alt="Comffordable Air Solutions HVAC Blog" class="hero-bg-img" loading="eager" width="1920" height="1080" />
            <div class="hero-overlay" style="background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.9));"></div>
            <div class="container hero-content text-center" style="margin: 0 auto;">
                <h1 data-cms="blog-hero-title" style="text-shadow: 2px 2px 10px rgba(0,0,0,0.8);">HVAC Tips &amp; Insights</h1>
                <p data-cms="blog-hero-sub" style="margin: 0 auto; font-size: 1.2rem; max-width: 600px; text-shadow: 1px 1px 5px rgba(0,0,0,0.8);">Expert advice to keep your Tampa Bay home comfortable year-round.</p>
            </div>
        </section>

        <!-- Blog Posts List -->
        <section data-cms="blog-posts">
            <div class="container">
                {allPosts.length > 0 ? (
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 2rem;">
                        {allPosts.map((post, i) => (
                            <a href={`/blog/${post.slug}`} class="glass-panel animate-on-scroll" style="text-decoration: none; display: flex; flex-direction: column; transition-delay: {i * 0.1}s;" data-cms={`blog-card-${i}`}>
                                {post.data.heroImage && (
                                    <img src={post.data.heroImage} alt="" style="width: 100%; height: 200px; object-fit: cover; border-radius: 8px; margin-bottom: 1rem;" loading="lazy" />
                                )}
                                <div style="flex: 1;">
                                    <div style="display: flex; gap: 0.75rem; margin-bottom: 0.75rem; flex-wrap: wrap;">
                                        {post.data.date && (
                                            <span style="font-size: 0.8rem; color: var(--primary-purple); font-weight: 600;">
                                                <i class="fa-regular fa-calendar"></i> {new Date(post.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                                            </span>
                                        )}
                                    </div>
                                    <h3 style="margin-bottom: 0.75rem; font-size: 1.25rem;">{post.data.title || 'Untitled'}</h3>
                                    <p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
                                        {post.data.description || ''}
                                    </p>
                                </div>
                                <div style="margin-top: 1.5rem;">
                                    <span class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.85rem;">Read More</span>
                                </div>
                            </a>
                        ))}
                    </div>
                ) : (
                    <div style="text-align: center; padding: 4rem 2rem;">
                        <i class="fa-solid fa-newspaper" style="font-size: 3rem; color: var(--primary-purple); margin-bottom: 1rem;"></i>
                        <h2 style="margin-bottom: 1rem;">Blog Coming Soon</h2>
                        <p style="max-width: 500px; margin: 0 auto 2rem; color: var(--text-secondary);">We're working on helpful HVAC articles for Tampa Bay homeowners. Check back soon for expert tips, maintenance guides, and industry insights.</p>
                        <a href="/contact" class="btn btn-primary">Contact Us</a>
                    </div>
                )}
            </div>
        </section>

        <!-- CTA -->
        <section style="background: linear-gradient(135deg, var(--bg-dark), var(--bg-darker)); text-align: center; border-top: 1px solid var(--glass-border);">
            <div class="container animate-on-scroll">
                <h2 style="margin-bottom: 1rem;">Need HVAC Help Now?</h2>
                <p style="margin-bottom: 2rem; max-width: 500px; margin-left: auto; margin-right: auto;">Our technicians are ready to help with any HVAC issue. Same-day service available across the Tampa Bay Area.</p>
                <a href="/contact" class="btn btn-primary" style="font-size: 1.1rem; padding: 1rem 2rem;">Schedule Service</a>
            </div>
        </section>
    </main>
</Layout>