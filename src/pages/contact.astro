---
import business from '../config/business.json';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.astro';
import EmbeddedMap from '../components/EmbeddedMap.astro';
import {
  telHref,
  formatAddress,
  formatHours,
  cityState,
  pageTitle,
  metaDescription,
  serviceAreaList,
} from '../lib/utils';

const title = pageTitle('Contact Us');
const description = metaDescription(
  `Contact ${business.name} for expert HVAC repair and installation in ${serviceAreaList()}. Get a free quote today.`
);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact', href: '/contact/' },
];

const address = formatAddress();
// Service-area business — no street address, so the map centers on the base city.
const mapQuery = `${business.name}, ${cityState()}`;

// The original site's quote form offered these options (not a 1:1 list of the
// service pages), plus a catch-all that ContactForm appends automatically.
const formServices = [
  { id: 'ac-repair', name: 'AC Repair & Installation' },
  { id: 'heating', name: 'Heating & Furnaces' },
  { id: 'maintenance', name: 'Preventative Maintenance' },
  { id: 'emergency', name: 'Emergency Service' },
];
---

<Layout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  pageType="contact"
  image="/images/contact-hero.webp"
  hideExitPopup
  hideCtaBar
>
  <Hero
    title={`Get In <span>Touch.</span>`}
    subtitle="Book your HVAC inspection or repair today."
    backgroundImage="/images/contact-hero.webp"
    cmsPrefix="contact-hero"
    size="half"
    center
  />

  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        <div>
          <div class="glass-panel">
            <h2 data-cms="contact-title">Expert Care at Your Door</h2>
            <p data-cms="contact-intro">
              Fill out the form to request a quote or call us directly. We provide professional
              HVAC services to the Tampa Bay Area, including {serviceAreaList()}.
            </p>
            <ul class="footer-contact" style="color:var(--text-secondary)">
              <li class="footer-contact-item">
                <i class="fa-solid fa-phone" aria-hidden="true"></i>
                <a href={telHref(business.phone)} data-cms="contact-phone">{business.phone}</a>
              </li>
              <li class="footer-contact-item">
                <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                <a href={`mailto:${business.email}`} data-cms="contact-email">{business.email}</a>
              </li>
              <li class="footer-contact-item">
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                <address style="font-style:normal" data-cms="contact-address">{address}</address>
              </li>
              {
                business.hours.length > 0 && (
                  <li class="footer-contact-item">
                    <i class="fa-solid fa-clock" aria-hidden="true" />
                    <ul class="footer-hours">
                      {business.hours.map((entry, i) => (
                        <li data-cms={`contact-hours-${i + 1}`}>{formatHours(entry)}</li>
                      ))}
                    </ul>
                  </li>
                )
              }
            </ul>
          </div>

          <div style="margin-top:1.5rem">
            <EmbeddedMap query={mapQuery} height={380} />
          </div>
        </div>

        <ContactForm title="Request a Free Quote" services={formServices} />
      </div>
    </div>
  </section>
</Layout>
