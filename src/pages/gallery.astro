---
import { getCollection } from 'astro:content';
import business from '../config/business.json';
import galleryData from '../config/gallery.json';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import CTASection from '../components/CTASection.astro';
import { cityState, pageTitle, metaDescription } from '../lib/utils';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const location = cityState();

const title = pageTitle('Photo & Video Gallery');
const description = metaDescription(
  `See recent ${business.industry.toLowerCase()} projects from ${business.name} across ${location} — real installs, repairs, and walkthrough videos.`
);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Gallery', href: '/gallery/' },
];
---

<Layout title={title} description={description} breadcrumbs={breadcrumbs} pageType="default">
  <Hero
    title={`Our Work in <span>${business.location.city}</span>`}
    subtitle={`Photos and video from recent jobs across ${location} — the actual work, not stock imagery.`}
    backgroundImage="/images/hero.jpg"
    cmsPrefix="gallery-hero"
    size="half"
    center
    ctaPrimary={{ text: 'Get a Free Quote', href: '/contact/' }}
  />

  <Gallery photos={galleryData.photos} videos={galleryData.videos} posts={posts} />

  <CTASection
    title="Want work like this at your place?"
    subtitle={`Request a free, no-obligation quote — most ${location} appointments are scheduled within 24 hours.`}
    ctaText="Get My Free Quote"
    ctaHref="/contact/"
    cmsPrefix="gallery-cta"
  />
</Layout>
