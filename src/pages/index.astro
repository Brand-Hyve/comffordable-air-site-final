---
import business from '../config/business.json';
import testimonials from '../config/testimonials.json';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ReviewsWidget from '../components/ReviewsWidget.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import ProcessSection from '../components/ProcessSection.astro';
import AboutPreview from '../components/AboutPreview.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import LocationCard from '../components/LocationCard.astro';
import { telHref, cityState, pageTitle, metaDescription, serviceAreaList } from '../lib/utils';

const location = cityState();

// Old-site title exceeded the 60-char window with the full brand suffix, so the
// short brand form is used ("Premium HVAC Repair & Installation | Comffordable Air").
const title = pageTitle('Premium HVAC Repair & Installation', business.shortName);
const description = metaDescription(
  `${business.name} provides expert AC repair, furnace maintenance, and HVAC installation in ${serviceAreaList()}, ${business.location.state}.`
);

const processSteps = [
  {
    number: 1,
    title: 'Book Service',
    description:
      "Give us a call to discuss your HVAC system's specific needs and set up a consistent maintenance schedule.",
  },
  {
    number: 2,
    title: 'Expert Solutions',
    description:
      "Comfort you can afford shouldn't mean cutting corners. Our specialists prioritize quality and transparency.",
  },
  {
    number: 3,
    title: 'We Handle the Work',
    description:
      'Our experienced technicians provide quality, service-driven solutions with extreme attention to detail.',
  },
];

const faqs = [
  {
    question: `Do you offer same-day service in ${business.location.city}?`,
    answer: `Yes. We hold open slots every day for same-day calls across ${location} and the surrounding areas. Call us in the morning and we can usually be out the same afternoon.`,
  },
  {
    question: 'How much does a service call cost?',
    answer:
      'We put the price in writing before any work begins. You approve the number first, and it does not change once the job starts unless you approve additional work.',
  },
  {
    question: 'Are you licensed and insured?',
    answer: business.license?.value
      ? `Yes. We hold ${business.license.name} ${business.license.value} and carry full liability insurance. We are happy to provide a certificate on request.`
      : 'Yes. We are fully licensed and insured, and we are happy to provide documentation on request.',
  },
  {
    question: 'What areas do you serve?',
    answer: `We serve ${business.serviceAreas.map((a) => a.name).join(', ')} and the surrounding communities — all of Pinellas County, into Hillsborough, and up to New Port Richey. If you are not sure whether you are in range, call and ask.`,
  },
  {
    question: 'Do you offer financing or maintenance plans?',
    answer:
      'Yes. We offer 0% financing options and a maintenance plan that bundles twice-yearly tune-ups with priority scheduling and repair discounts. Ask about both when you request your quote.',
  },
];

const featuredAreas = business.serviceAreas.slice(0, 3);
---

<Layout title={title} description={description} pageType="home">
  <Hero
    title={`AC Repair & HVAC Services in <span>Tampa Bay, FL</span>`}
    subtitle={`Expert HVAC repair, installation, and maintenance across the Tampa Bay Area. We specialize in keeping your home perfectly tempered with quality service in ${serviceAreaList()}.`}
    backgroundImage="/images/hero.webp"
    cmsPrefix="hero"
    size="full"
    ctaPrimary={{
      text: business.phone,
      href: telHref(business.phone),
      icon: 'fa-solid fa-phone',
    }}
    ctaSecondary={{
      text: '24/7 Emergency Service',
      href: '/contact/',
      icon: 'fa-solid fa-bolt',
    }}
  />

  {
    (business.reviewsWidget.scriptSrc || business.reviewsWidget.iframeSrc) && (
      <section class="section" style="padding:3rem 0 1.5rem">
        <div class="container">
          <ReviewsWidget
            scriptSrc={business.reviewsWidget.scriptSrc}
            iframeSrc={business.reviewsWidget.iframeSrc}
          />
        </div>
      </section>
    )
  }

  <ProcessSection steps={processSteps} label="How It Works" title="The Comffordable Process" />

  <ServicesGrid label="Our Expertise" title="Premium HVAC Services" />

  <AboutPreview />

  <Testimonials testimonials={testimonials.slice(0, 3)} />

  {
    featuredAreas.length > 0 && (
      <section class="section section-alt">
        <div class="container">
          <div class="section-head-center">
            <span class="section-label" data-cms="areas-label">
              Where We Work
            </span>
            <h2 class="section-title" data-cms="areas-title">
              Proudly Serving {business.location.state}
            </h2>
          </div>
          <div class="grid grid-3" data-cms-collection="areas-grid">
            {featuredAreas.map((area) => (
              <LocationCard area={area} collectionId="areas-grid" />
            ))}
          </div>
          <p style="text-align:center;margin-top:2.5rem">
            <a class="btn btn-outline" href="/service-areas/">
              View All Service Areas
            </a>
          </p>
        </div>
      </section>
    )
  }

  <FAQSection items={faqs} cmsPrefix="home-faq" />

  <CTASection
    title="Ready for Comffordable Comfort?"
    subtitle={`Unhappy with your current service? It's time for consistency, communication, and quality. Professional HVAC repair and air quality solutions for ${serviceAreaList()}.`}
    ctaText="Get Your Free Quote"
    ctaHref="/contact/"
    cmsPrefix="home-cta"
  />
</Layout>
