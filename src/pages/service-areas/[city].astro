---
import type { GetStaticPaths } from 'astro';
import business from '../../config/business.json';
import testimonials from '../../config/testimonials.json';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Neighborhoods from '../../components/Neighborhoods.astro';
import Landmarks from '../../components/Landmarks.astro';
import EmbeddedMap from '../../components/EmbeddedMap.astro';
import Testimonials from '../../components/Testimonials.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';
import { telHref, pageTitle, metaDescription } from '../../lib/utils';

export const getStaticPaths = (() => {
  return business.serviceAreas.map((area) => ({
    params: { city: area.id },
    props: { area },
  }));
}) satisfies GetStaticPaths;

const { area } = Astro.props;

const title = pageTitle(`${area.name} AC Repair`);
const description = metaDescription(
  `Premium HVAC repair, installation, and preventative maintenance services in ${area.name}, ${area.state}.`
);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: area.name, href: `/service-areas/${area.id}/` },
];

const faqs = [
  {
    question: `Do you offer same-day service in ${area.name}?`,
    answer: `Yes. ${area.name} is inside our core service radius, and we reserve same-day slots every weekday for the area.`,
  },
  {
    question: `What does a service call in ${area.name} cost?`,
    answer:
      'You get a flat, written quote before any work starts. There are no diagnostic surprises and no change to the price once you approve it.',
  },
  {
    question: `Which ${area.name} neighborhoods do you cover?`,
    answer:
      area.neighborhoods.length > 0
        ? `We work throughout ${area.name}, including ${area.neighborhoods.join(', ')}.`
        : `We work throughout ${area.name} and the immediately surrounding communities.`,
  },
];

const firstLandmark = area.landmarks[0];
const lastLandmark = area.landmarks[area.landmarks.length - 1];

const localTestimonials = testimonials.filter((t) => t.location.startsWith(area.name));
const shownTestimonials = (localTestimonials.length ? localTestimonials : testimonials).slice(0, 3);
---

<Layout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  pageType="location"
  image={area.hero}
  location={{ name: area.name, state: area.state, wiki: area.wiki }}
>
  <Hero
    title={`AC Repair in <span>${area.name}, ${area.state}.</span>`}
    subtitle={`Premium HVAC solutions delivered straight to your home in ${area.name}. Experience Comffordable Air today.`}
    backgroundImage={area.hero}
    cmsPrefix={`location-hero-${area.id}`}
    size="half"
    center
    ctaPrimary={{ text: 'Book Now', href: '/contact/', icon: 'fa-solid fa-calendar-check' }}
    ctaSecondary={{
      text: `Call ${business.phone}`,
      href: telHref(business.phone),
      icon: 'fa-solid fa-phone',
    }}
  />

  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        <div>
          <span class="section-label" data-cms={`city-${area.id}-label`}>
            {area.name}, {area.state}
          </span>
          <h2 class="section-title" data-cms={`city-${area.id}-title`}>
            Your Local {area.name} HVAC Experts
          </h2>
          <p data-cms={`city-${area.id}-body-1`}>
            As a dedicated service area, {area.name}, {area.state} holds a special place for
            {business.name}. We traverse the entire area to provide the highest standard of AC
            repair, heating maintenance, and full system installations.
          </p>
          <p data-cms={`city-${area.id}-body-2`}>
            Whether you need an emergency repair during the peak of the Florida summer, or a
            proactive maintenance tune-up to extend the life of your equipment, we have the
            expertise and the dedication to get it done right in your home.
          </p>
          <ul class="service-features" data-cms={`city-${area.id}-points`}>
            <li>Transparent, upfront pricing with no hidden fees.</li>
            <li>Professional HVAC technicians serving the {area.name} community.</li>
            <li>5-Star Rated for comfort you can afford and trust.</li>
          </ul>
        </div>

        <div class="glass-panel animate-on-scroll">
          <h3 data-cms={`city-${area.id}-panel-title`}>Service in {area.name}</h3>
          <p data-cms={`city-${area.id}-panel-body`}>
            {business.name} provides reliable HVAC care throughout {area.name}. We take the
            guesswork out of air conditioning by handling the repairs and the optimization,
            allowing you to enjoy a perfectly tempered home with family and friends.
          </p>
          <p style="margin:0">
            <a class="btn btn-primary" href="/ac-repair/" data-cms={`city-${area.id}-panel-cta`}>
              View Services
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <Neighborhoods
    name={area.name}
    neighborhoods={area.neighborhoods}
    title={`Serving All ${area.name} Neighborhoods`}
    intro={`Our technicians are frequent visitors to your neighborhood and beyond. We provide ${area.name} residents with professional HVAC care that stands up to the intense Florida elements.`}
  />

  <Landmarks
    name={area.name}
    landmarks={area.landmarks}
    wiki={area.wiki}
    label="Local Favorites"
    title="Landmarks & Points of Interest"
    intro={`Whether you're visiting ${firstLandmark} or living right next to ${lastLandmark}, we're your go-to HVAC pros in the ${area.name} area.`}
  />

  <section class="section">
    <div class="container">
      <div class="section-head-center">
        <span class="section-label" data-cms={`city-${area.id}-services-label`}>
          Expert Comfort
        </span>
        <h2 class="section-title" data-cms={`city-${area.id}-services-title`}>
          Premium HVAC in {area.name}
        </h2>
      </div>
      <div class="grid grid-2" data-cms-collection={`city-${area.id}-services-grid`}>
        <article
          class="glass-panel glass-panel-hover service-card animate-on-scroll"
          data-cms-item={`city-${area.id}-services-grid`}
        >
          <span class="service-icon">
            <i class="fa-solid fa-snowflake" aria-hidden="true"></i>
          </span>
          <h3 data-cms={`city-${area.id}-svc-1-title`}>AC Repair</h3>
          <p data-cms={`city-${area.id}-svc-1-desc`}>
            From emergency repairs to high-efficiency installations in {area.name}.
          </p>
          <a class="btn btn-outline btn-sm" href="/ac-repair/" data-cms={`city-${area.id}-svc-1-cta`}>
            Learn More →
          </a>
        </article>
        <article
          class="glass-panel glass-panel-hover service-card animate-on-scroll"
          data-cms-item={`city-${area.id}-services-grid`}
        >
          <span class="service-icon">
            <i class="fa-solid fa-clipboard-check" aria-hidden="true"></i>
          </span>
          <h3 data-cms={`city-${area.id}-svc-2-title`}>Maintenance</h3>
          <p data-cms={`city-${area.id}-svc-2-desc`}>
            Proactive tune-ups and air quality solutions right here in {area.name}.
          </p>
          <a class="btn btn-outline btn-sm" href="/maintenance/" data-cms={`city-${area.id}-svc-2-cta`}>
            Learn More →
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head-center">
        <h2 class="section-title" data-cms={`city-${area.id}-map-title`}>
          Our {area.name} Service Area
        </h2>
      </div>
      <EmbeddedMap query={`${area.name}, ${area.state}`} height={420} />
    </div>
  </section>

  <Testimonials
    testimonials={shownTestimonials}
    title={`What ${area.name} Customers Say`}
    cmsPrefix={`city-${area.id}-testimonials`}
  />

  <FAQSection
    items={faqs}
    title={`${area.name} Service FAQs`}
    cmsPrefix={`city-${area.id}-faq`}
  />

  <CTASection
    title={`Need service in ${area.name}?`}
    subtitle="Call now or request a free quote — most appointments are scheduled within 24 hours."
    ctaText="Get My Free Quote"
    ctaHref="/contact/"
    cmsPrefix={`city-${area.id}-cta`}
  />
</Layout>
