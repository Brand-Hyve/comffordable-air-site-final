---
import business from '../../config/business.json';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import LocationCard from '../../components/LocationCard.astro';
import CTASection from '../../components/CTASection.astro';
import { telHref, pageTitle, metaDescription } from '../../lib/utils';

const areas = business.serviceAreas;

// Original title used a descriptive suffix rather than the brand name.
const title = pageTitle('Service Areas', 'HVAC Solutions Florida');
const description = metaDescription(
  'Comffordable Air Solutions provides premium AC repair and maintenance to St. Petersburg, Tampa, and Clearwater.'
);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
];
---

<Layout title={title} description={description} breadcrumbs={breadcrumbs} pageType="location">
  <Hero
    title={`Service <span>Areas.</span>`}
    subtitle="Premium HVAC maintenance delivered to your doorstep in the Tampa Bay Area."
    backgroundImage="/images/service-areas-hero.webp"
    cmsPrefix="areas-hero"
    size="half"
    center
    ctaPrimary={{ text: 'Get a Free Quote', href: '/contact/' }}
  />

  <section class="section">
    <div class="container">
      <div class="section-head-center">
        <span class="section-label" data-cms="areas-index-label">Coverage Map</span>
        <h2 class="section-title" data-cms="areas-index-title">We Come To You</h2>
        <p class="section-intro" data-cms="areas-index-intro">
          Don't suffer in the Florida heat with a broken AC. Our fully-equipped HVAC specialists
          travel to your home, complete with all the necessary tools and professional-grade
          equipment.
        </p>
      </div>

      {
        areas.length === 0 ? (
          <p class="glass-panel" data-cms="areas-index-empty">
            Service area details are coming soon. Call us to confirm coverage for your address.
          </p>
        ) : (
          <div class="grid grid-3" data-cms-collection="areas-grid">
            {areas.map((area) => (
              <LocationCard area={area} collectionId="areas-grid" />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <CTASection
    title="Don't see your city listed?"
    subtitle="We serve many other surrounding communities in the area."
    ctaText="Call to Verify Your Area"
    ctaHref={telHref(business.phone)}
    cmsPrefix="areas-cta"
  />
</Layout>
