---
import business from '../config/business.json';
import Layout from '../layouts/Layout.astro';
import { formatAddress, pageTitle, metaDescription } from '../lib/utils';

const title = pageTitle('Terms & Conditions');
const description = metaDescription(
  `The terms that apply when you use the ${business.name} website, request a quote, or opt in to text messages from us.`
);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Terms & Conditions', href: '/terms/' },
];

const effectiveDate = 'January 1, 2025';
---

<Layout title={title} description={description} breadcrumbs={breadcrumbs} pageType="default">
  <section class="section">
    <div class="container">
      <div class="article-body">
        <h1 data-cms="terms-title">Terms &amp; Conditions</h1>
        <p><em>Effective {effectiveDate}</em></p>

        <p data-cms="terms-intro">
          These terms apply when you use the {business.name} website, request a quote, or receive
          messages from us. By using this site or contacting us through it, you agree to what
          follows.
        </p>

        <h2>Quotes and estimates</h2>
        <p>
          Prices, promotions, and availability shown on this site are provided for general
          information and may change without notice. Any estimate becomes binding only once it is
          confirmed in writing for your specific equipment and property, after our technician has
          assessed the work. Diagnostic findings can change the scope and the price.
        </p>

        <h2>Service and workmanship</h2>
        <p>
          We perform HVAC work in line with our {business.license.name} (#{business.license.value})
          and applicable code. Manufacturer warranties on equipment are provided by the manufacturer and
          are subject to their terms, including registration and maintenance requirements. Skipping
          recommended maintenance may void equipment coverage.
        </p>

        <h2>Scheduling, access, and cancellation</h2>
        <p>
          Appointment windows are estimates and can shift with emergency calls and weather. You are
          responsible for providing safe access to the equipment. If we cannot access the property at
          the scheduled time, we may need to reschedule.
        </p>

        <h2>Text messages (SMS)</h2>
        <p data-cms="terms-sms">
          If you give us your mobile number, you may receive service, scheduling, and account
          messages from us. You can cancel the SMS service at any time by texting
          <strong>STOP</strong> to the number that messaged you. We will confirm your unsubscribe by
          SMS, after which you will no longer receive messages from us. To rejoin, sign up again as
          you did initially. If you have trouble with the messaging program, reply
          <strong>HELP</strong> for assistance. Carriers are not liable for delayed or undelivered
          messages. Message and data rates may apply for messages sent to you and from you.
          Message frequency varies. Consent to receive messages is not a condition of purchase.
        </p>

        <h2>Payment</h2>
        <p>
          Payment is due on completion unless we have agreed otherwise in writing. Maintenance plan
          billing continues on the interval you selected until you cancel.
        </p>

        <h2>Website content</h2>
        <p>
          The text, images, and marks on this site belong to {business.name} or are used with
          permission, and may not be reproduced without our consent. We work to keep the site
          accurate, but we do not warrant that every detail is current or error-free.
        </p>

        <h2>Limitation of liability</h2>
        <p>
          To the extent permitted by Florida law, our liability arising from this website or from
          services performed is limited to the amount paid for the service in question. We are not
          liable for indirect or consequential losses.
        </p>

        <h2>Governing law</h2>
        <p>
          These terms are governed by the laws of the State of Florida.
        </p>

        <h2>Changes to these terms</h2>
        <p>
          If we change these terms we will update the effective date above. Material changes will be
          noted on this page.
        </p>

        <h2>Contact us</h2>
        <p data-cms="terms-contact">
          {business.name}<br />
          {formatAddress()}<br />
          Phone: {business.phone}<br />
          Email: {business.email}
        </p>
      </div>
    </div>
  </section>
</Layout>
